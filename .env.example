# Copy to .env.local and fill in. Values are baked into the build.

# EmailJS (https://dashboard.emailjs.com). Without these, the contact form
# falls back to opening the visitor's email app addressed to info@connectingcloud.co.
# Template variables available: name, organization, role, email, interest, message
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Calendly / Cal.com booking link. Without it, "Book" buttons open the contact page.
VITE_BOOKING_URL=

# Plausible analytics site domain, e.g. connectingcloud.co. Leave empty to disable.
VITE_PLAUSIBLE_DOMAIN=
