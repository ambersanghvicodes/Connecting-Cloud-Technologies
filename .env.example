# Copy to .env and fill in. Values are baked into the build.

# Google Apps Script web app for the contact form (setup in README).
# Without it, the form opens the visitor's email app addressed to info@connectingcloud.co.
VITE_BRIEFING_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id/exec

# Calendly / Cal.com booking link. Without it, "Book" buttons open the contact page.
VITE_BOOKING_URL=

# Plausible analytics site domain, e.g. www.connectingcloud.co. Leave empty to disable.
VITE_PLAUSIBLE_DOMAIN=
